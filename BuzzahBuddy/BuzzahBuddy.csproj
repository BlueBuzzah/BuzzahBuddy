<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Only targeting iOS and Android (net10.0 added because a ProjectReference from a plain-TFM
		     test project would force restore to resolve assets for every TFM here, including
		     android/ios, which fails with NETSDK1147 when those workloads aren't installed; test
		     projects instead Compile-Include the net10.0-safe sources directly, which needs this TFM) -->
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>

		<!-- Exe requires a platform-generated Main; plain net10.0 has none, so it builds as a library -->
		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
		<RootNamespace>BuzzahBuddy</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>BuzzahBuddy</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.rbonestell.buzzahbuddy</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<!-- Platform versions -->
		<SupportedOSPlatformVersion
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- 24.0 (Android 7.0), not 21: .NET 10 recommends a 24 floor to avoid runtime
		     crashes from Java default-interface-method desugaring. Raising this drops
		     Android 5.0/5.1/6.0 users, who stop receiving updates. -->
		<SupportedOSPlatformVersion
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Disable Xcode version check due to version numbering mismatch -->
		<ValidateXcodeVersion>false</ValidateXcodeVersion>

		<!-- Enable compiled bindings with Source for performance optimization -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Suppress false-positive binding warnings -->
		<!-- XC0022: ItemDisplayBinding on Picker cannot use compiled bindings (no DataTemplate) -->
		<!-- XC0045: RelativeSource bindings intentionally access parent ViewModel -->
		<!-- XC0023: x:DataType={x:Null} bindings in item templates are deliberate — the
		     "compiled" RelativeSource AncestorType alternative silently fails to resolve
		     in CollectionView item containers on device (dead Connect button) -->
		<NoWarn>$(NoWarn);XC0022;XC0045;XC0023</NoWarn>

		<!-- Dynamic code does not exist on iOS Release: it is full AOT ("aot-only mode"),
		     so anything needing runtime codegen throws ExecutionEngineException on device
		     while working fine in Debug and on the simulator's JIT. Two shipped builds
		     (0.1.2 launch crash, 0.1.3 "Connection Error" on BLE connect) were exactly this.
		     EnableAotAnalyzer flags calls to [RequiresDynamicCode] APIs as IL3050, and
		     WarningsAsErrors turns that into a build failure, so the class of bug cannot
		     reach a release again.

		     NOT IsAotCompatible=true: that also sets IsTrimmable=true, which would opt this
		     assembly into full trimming despite TrimMode=partial and risk stripping
		     XAML-referenced types. This is analyzer-only and changes no build output.

		     Scope note: this covers OUR calls into annotated APIs. It cannot see dynamic
		     code inside MAUI/Plugin.BLE internals (the 0.1.2 launch crash lived there), so
		     it is a guardrail, not a proof of AOT safety. Launching a Release build is
		     still the only way to catch those. -->
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL3050</WarningsAsErrors>
	</PropertyGroup>

	<!-- Android Debug Configuration -->
	<PropertyGroup
		Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Debug'">
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<AndroidUseAapt2>true</AndroidUseAapt2>
	</PropertyGroup>

	<!-- Release Configuration: Trimming and optimization -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PublishTrimmed>true</PublishTrimmed>
		<!-- Kept at "partial" deliberately. Persistence no longer depends on it:
		     PreferencesStorageService serializes through the source-generated
		     StorageJsonContext, not reflection. But "full" would trim this assembly too,
		     which is the same risk the IsAotCompatible note above avoids (it implies
		     IsTrimmable). Test a Release build on device before changing this. -->
		<TrimMode>partial</TrimMode>
	</PropertyGroup>

	<!-- Release iOS crashes on launch without this. MAUI's ApplicationHandler.MapAppTheme
	     runs on every startup and reads UIApplication.ConnectedScenes, which returns
	     NSSet<UIScene> via ObjCRuntime.Runtime.ConstructNSObject -> ConstructorInfo.Invoke.
	     Since .NET 8, MethodBase.Invoke prefers an emitted invoke stub, and the emit path
	     is still selected under Mono full AOT, so the stub needs a JIT that isn't
	     there, and startup dies with:
	       ExecutionEngineException: Attempting to JIT compile method
	       '(wrapper dynamic-method) InvokeStub_NSSet`1..ctor' while running in aot-only mode
	     The switch forces the interpreted (non-emit) invoke path instead. Android is
	     unaffected because its SDK already sets this itself (AndroidAvoidEmitForPerformance
	     in Microsoft.Android.Sdk.RuntimeConfig.targets); the iOS SDK does not, which is the
	     entire asymmetry. Debug hides it, because Debug is not AOT and the JIT is there.
	     Do not scope this to Android too: that would collide with the Android SDK's item. -->
	<ItemGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<RuntimeHostConfigurationOption Include="Switch.System.Reflection.ForceInterpretedInvoke" Value="true" Trim="true" />
	</ItemGroup>

	<ItemGroup>
		<!-- App icon: the design system's iOS icon (assets/iOS). Android uses the design
		     system's adaptive mipmaps under Platforms/Android/Resources instead. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />

		<!-- Splash: the mark on abyss (#011F5F); a launch screen shows before the app can read its theme. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#011F5F" BaseSize="128,123" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- The 512px mark is shown at 48 tall; a 96px base keeps the generated densities small. -->
		<MauiImage Update="Resources\Images\bluebuzzah_mark.png" BaseSize="96,92" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="Plugin.BLE" Version="3.2.1" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<!-- PDFsharp pulls Pkcs 8.0.1, which has known advisories (NU1902/NU1903); this overrides it. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<!-- The shared PDF report (Services/Reports/ReportPdf.cs) reads its fonts and the mark from
	     these resources; it holds no MAUI types and can't use MauiFont/MauiImage files. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\Fonts\Lexend-Medium.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\Lexend-SemiBold.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\Lexend-Bold.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\AtkinsonHyperlegibleNext-Regular.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\AtkinsonHyperlegibleNext-Bold.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Brand\bluebuzzah-mark.png" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
