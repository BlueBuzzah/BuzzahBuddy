<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Only targeting iOS and Android (net10.0 added because a ProjectReference from a plain-TFM
		     test project would force restore to resolve assets for every TFM here, including
		     android/ios, which fails with NETSDK1147 when those workloads aren't installed; test
		     projects instead Compile-Include the net10.0-safe sources directly, which needs this TFM) -->
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>

		<!-- Exe requires a platform-generated Main; plain net10.0 has none, so it builds as a library -->
		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
		<RootNamespace>BuzzahBuddy</RootNamespace>
		<UseMaui>true</UseMaui>
		<!-- Pinned: unset, it follows the installed workload, so the iOS release (workload 10.0.401,
		     MAUI 10.0.20) and local builds ran different MAUI and the simulator hid an iOS bug.
		     Bump it by hand; it is independent of the workload/Xcode pins in .github/workflows. -->
		<MauiVersion>10.0.120</MauiVersion>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>BuzzahBuddy</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.rbonestell.buzzahbuddy</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<!-- Platform versions -->
		<SupportedOSPlatformVersion
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- 24.0 (Android 7.0), not 21: .NET 10 recommends a 24 floor to avoid runtime
		     crashes from Java default-interface-method desugaring. Raising this drops
		     Android 5.0/5.1/6.0 users, who stop receiving updates. -->
		<SupportedOSPlatformVersion
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Disable Xcode version check due to version numbering mismatch -->
		<ValidateXcodeVersion>false</ValidateXcodeVersion>

		<!-- Enable compiled bindings with Source for performance optimization -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Suppress false-positive binding warnings -->
		<!-- XC0022: ItemDisplayBinding on Picker cannot use compiled bindings (no DataTemplate) -->
		<!-- XC0045: RelativeSource bindings intentionally access parent ViewModel -->
		<!-- XC0023: x:DataType={x:Null} bindings in item templates are deliberate — the
		     "compiled" RelativeSource AncestorType alternative silently fails to resolve
		     in CollectionView item containers on device (dead Connect button) -->
		<NoWarn>$(NoWarn);XC0022;XC0045;XC0023</NoWarn>

		<!-- Dynamic code does not exist on iOS Release: it is full AOT ("aot-only mode"),
		     so anything needing runtime codegen throws ExecutionEngineException on device
		     while working fine in Debug and on the simulator's JIT. Two shipped builds
		     (0.1.2 launch crash, 0.1.3 "Connection Error" on BLE connect) were exactly this.
		     EnableAotAnalyzer flags calls to [RequiresDynamicCode] APIs as IL3050, and
		     WarningsAsErrors turns that into a build failure, so the class of bug cannot
		     reach a release again.

		     NOT IsAotCompatible=true: that also sets IsTrimmable=true, which would opt this
		     assembly into full trimming despite TrimMode=partial and risk stripping
		     XAML-referenced types. This is analyzer-only and changes no build output.

		     Scope note: this covers OUR calls into annotated APIs. It cannot see dynamic
		     code inside MAUI/Plugin.BLE internals (the 0.1.2 launch crash lived there), so
		     it is a guardrail, not a proof of AOT safety. Launching a Release build is
		     still the only way to catch those. -->
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL3050</WarningsAsErrors>
	</PropertyGroup>

	<!-- Android Debug Configuration -->
	<PropertyGroup
		Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Debug'">
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<AndroidUseAapt2>true</AndroidUseAapt2>
	</PropertyGroup>

	<!-- Google Play flags DEX obfuscation under 25%. Unset, AndroidLinkTool runs d8 only, so
	     no Java code was shrunk or renamed. The SDK generates keep rules for every class
	     managed code reaches over JNI. private-members is the only obfuscating value
	     AndroidR8ObfuscationMode accepts (the other is disabled). The mapping file goes into the AAB's
	     BUNDLE-METADATA, so Play deobfuscates crash reports without an upload step.
	     AndroidR8ObfuscationMode needs Android pack 36.1.118+; older packs ignore it. -->
	<PropertyGroup
		Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Release'">
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidR8ObfuscationMode>private-members</AndroidR8ObfuscationMode>
	</PropertyGroup>

	<!-- Release Configuration: Trimming and optimization -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PublishTrimmed>true</PublishTrimmed>
		<!-- Kept at "partial" deliberately. Persistence no longer depends on it:
		     PreferencesStorageService serializes through the source-generated
		     StorageJsonContext, not reflection. But "full" would trim this assembly too,
		     which is the same risk the IsAotCompatible note above avoids (it implies
		     IsTrimmable). Test a Release build on device before changing this. -->
		<TrimMode>partial</TrimMode>
	</PropertyGroup>

	<!-- Release iOS crashes on launch without this. MAUI's ApplicationHandler.MapAppTheme
	     runs on every startup and reads UIApplication.ConnectedScenes, which returns
	     NSSet<UIScene> via ObjCRuntime.Runtime.ConstructNSObject -> ConstructorInfo.Invoke.
	     Since .NET 8, MethodBase.Invoke prefers an emitted invoke stub, and the emit path
	     is still selected under Mono full AOT, so the stub needs a JIT that isn't
	     there, and startup dies with:
	       ExecutionEngineException: Attempting to JIT compile method
	       '(wrapper dynamic-method) InvokeStub_NSSet`1..ctor' while running in aot-only mode
	     The switch forces the interpreted (non-emit) invoke path instead. Android is
	     unaffected because its SDK already sets this itself (AndroidAvoidEmitForPerformance
	     in Microsoft.Android.Sdk.RuntimeConfig.targets); the iOS SDK does not, which is the
	     entire asymmetry. Debug hides it, because Debug is not AOT and the JIT is there.
	     Do not scope this to Android too: that would collide with the Android SDK's item. -->
	<ItemGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<RuntimeHostConfigurationOption Include="Switch.System.Reflection.ForceInterpretedInvoke" Value="true" Trim="true" />
	</ItemGroup>

	<ItemGroup>
		<!-- App icon: the design system's iOS icon (assets/iOS). Android uses the design
		     system's adaptive mipmaps under Platforms/Android/Resources instead. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />

		<!-- Splash: the mark on abyss (#011F5F); a launch screen shows before the app can read its theme. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#011F5F" BaseSize="128,123" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- The 512px mark is shown at 48 tall; a 96px base keeps the generated densities small. -->
		<MauiImage Update="Resources\Images\bluebuzzah_mark.png" BaseSize="96,92" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
		<PackageReference Include="Plugin.BLE" Version="3.2.1" />
		<!-- Stay on 6.2.x: 6.5.0+ is AGPL-3.0 with a runtime license check (MIT through 6.2.4). -->
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<!-- PDFsharp pulls Pkcs 8.0.1, which has known advisories (NU1902/NU1903); this overrides it. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<!-- The shared PDF report (Services/Reports/ReportPdf.cs) reads its fonts and the mark from
	     these resources; it holds no MAUI types and can't use MauiFont/MauiImage files. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\Fonts\Lexend-Medium.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\Lexend-SemiBold.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\Lexend-Bold.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\AtkinsonHyperlegibleNext-Regular.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Fonts\AtkinsonHyperlegibleNext-Bold.ttf" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Brand\bluebuzzah-mark.png" LogicalName="BuzzahBuddy.Report.%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Siri voice commands (iOS only): the Swift App Intents framework in native/BuzzahBuddyKit,
	     built and bound by BuzzahBuddy.Native.Binding. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<ProjectReference Include="..\BuzzahBuddy.Native.Binding\BuzzahBuddy.Native.Binding.csproj" />
	</ItemGroup>

	<!-- The iOS SDK's _CompileAppManifest doesn't list Info.plist among its Inputs, so an edited
	     (or merged) Info.plist leaves the old obj/.../AppManifest.plist in the app. -->
	<Target Name="AddInfoPlistToAppManifestInputs" AfterTargets="_CompileAppManifestInputs">
		<ItemGroup>
			<_CompileAppManifestInputFile Include="$(AppBundleManifest)" />
		</ItemGroup>
	</Target>

	<!-- iOS discovers App Intents only from Metadata.appintents inside the .app. The binding's
	     ExtractAppIntentsMetadata target takes the device and simulator copies out of the
	     framework's xcarchives; this copies the one matching the build in, replacing any earlier
	     copy. Keep the slash after $(AppBundleDir): without it the folder lands beside the bundle
	     and every intent fails silently. -->
	<Target Name="CopyAppIntentsMetadata" AfterTargets="_CopyResourcesToBundle"
		Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PropertyGroup>
			<_AppIntentsVariant Condition="'$(SdkIsSimulator)' == 'true'">simulator</_AppIntentsVariant>
			<_AppIntentsVariant Condition="'$(SdkIsSimulator)' != 'true'">device</_AppIntentsVariant>
			<_BindingMetadataDir>..\BuzzahBuddy.Native.Binding\obj\$(Configuration)\$(TargetFramework)\xcode\AppIntentsMetadata\$(_AppIntentsVariant)\Metadata.appintents</_BindingMetadataDir>
		</PropertyGroup>
		<ItemGroup>
			<_AppIntentsMetadata Include="$(_BindingMetadataDir)\**\*" Condition="Exists('$(_BindingMetadataDir)')" />
		</ItemGroup>
		<Error Text="Metadata.appintents not found at $(_BindingMetadataDir); Siri would find no intents." Condition="'@(_AppIntentsMetadata)' == ''" />
		<RemoveDir Directories="$(AppBundleDir)/Metadata.appintents" />
		<Copy SourceFiles="@(_AppIntentsMetadata)"
			DestinationFolder="$(AppBundleDir)/Metadata.appintents/%(RecursiveDir)" />
		<Message Importance="high" Text="Copied $(_AppIntentsVariant) Metadata.appintents from $(_BindingMetadataDir)" />
	</Target>

	<!-- The framework's build trains Siri's phrase model (Metadata.appintents/nlu) under the
	     framework's bundle id, so Siri may not file the phrases under this app. Retrain it here
	     under the app's id, from the compiled app manifest: its display name, INAlternativeAppNames
	     and CFBundleDevelopmentRegion (no region, no model). The options are Xcode's own. -->
	<Target Name="TrainAppIntentsPhrases" AfterTargets="CopyAppIntentsMetadata"
		Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PropertyGroup>
			<_AppIntentsTrainingDir>$(IntermediateOutputPath)appintents-ssu</_AppIntentsTrainingDir>
			<_AppIntentsMetadataDir>$(AppBundleDir)/Metadata.appintents</_AppIntentsMetadataDir>
		</PropertyGroup>
		<RemoveDir Directories="$(_AppIntentsMetadataDir)/nlu;$(_AppIntentsTrainingDir)" />
		<MakeDir Directories="$(_AppIntentsTrainingDir)" />
		<WriteLinesToFile File="$(_AppIntentsTrainingDir)/dependencies.list" Lines="" Overwrite="true" />
		<Exec Command="xcrun appintentsnltrainingprocessor --infoplist-path &quot;$(_TemporaryAppManifest)&quot; --source-file &quot;$(_TemporaryAppManifest)&quot; --bundle-id $(ApplicationId) --extracted-metadata-path &quot;$(_AppIntentsMetadataDir)&quot; --product-path &quot;$(AppBundleDir)&quot; --temp-dir-path &quot;$(_AppIntentsTrainingDir)&quot; --metadata-file-list &quot;$(_AppIntentsTrainingDir)/dependencies.list&quot; --deployment-postprocessing --archive-ssu-assets" />
		<Error Text="Siri phrase training produced no model; check CFBundleDevelopmentRegion in Platforms/iOS/Info.plist." Condition="!Exists('$(_AppIntentsMetadataDir)/nlu/nlu.lzfse')" />
		<Message Importance="high" Text="Trained Siri phrases for $(ApplicationId)" />
	</Target>

	<!-- The embedded framework keeps its own copy of the same intents and phrases under its own id.
	     The app's copy above is the one Siri should use, so ship only that one. The SDK copies the
	     framework into the bundle in _CopyDirectoriesToBundle, after the targets above. -->
	<Target Name="RemoveFrameworkAppIntentsMetadata" AfterTargets="_CopyDirectoriesToBundle"
		Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<RemoveDir Directories="$(AppBundleDir)/Frameworks/BuzzahBuddyKit.framework/Metadata.appintents" />
	</Target>

</Project>
