<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Built on the BlueBuzzah design system. Colors, sizes and type come from the
         generated Themes/*Theme.g.xaml, Tokens.g.xaml and Type.g.xaml (see
         scripts/gen_design_tokens.py); bind colors with DynamicResource so the theme
         can change at runtime. Control anatomy follows components/bundle.css. -->

    <!-- Buttons (Button README; bundle .bb-btn). lg = target-lg 56 (BuzzahBuddy default),
         Xl = target-xl 72 for Start / Pause / Stop. Outlined variants carry a 2px border in
         the label color; primary and danger are solid. Focused draws a 3px focus border
         (native controls can't draw the 2px outer gap of focus-ring). -->
    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans700}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TargetLg}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource Target}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMdInt}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Brand}" />
        <Setter Property="TextColor" Value="{DynamicResource OnBrand}" />
        <Setter Property="BorderColor" Value="{DynamicResource Brand}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource BrandPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource Focus}" />
                            <Setter Property="BorderWidth" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource FillDisabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource InkDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource InkDisabled}" />
                            <Setter Property="BorderWidth" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="BackgroundColor" Value="{DynamicResource BrandSoft}" />
        <Setter Property="TextColor" Value="{DynamicResource Brand}" />
        <Setter Property="BorderColor" Value="{DynamicResource Brand}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource BrandPressed}" />
                            <Setter Property="BorderColor" Value="{DynamicResource BrandPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource Focus}" />
                            <Setter Property="BorderWidth" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource FillDisabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource InkDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource InkDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonQuiet" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Brand}" />
        <Setter Property="BorderColor" Value="{DynamicResource Brand}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource BrandSoft}" />
                            <Setter Property="TextColor" Value="{DynamicResource BrandPressed}" />
                            <Setter Property="BorderColor" Value="{DynamicResource BrandPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource Focus}" />
                            <Setter Property="BorderWidth" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource FillDisabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource InkDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource InkDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Destructive actions only, always behind a confirmation sheet. Pressed uses opacity
         0.92 in place of the bundle's brightness(0.92); MAUI has no filters. -->
    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Danger}" />
        <Setter Property="TextColor" Value="{DynamicResource OnStatus}" />
        <Setter Property="BorderColor" Value="{DynamicResource Danger}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.92" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource Focus}" />
                            <Setter Property="BorderWidth" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource FillDisabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource InkDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource InkDisabled}" />
                            <Setter Property="BorderWidth" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonPrimaryXl" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="FontFamily" Value="{DynamicResource FontDisplay600}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TargetXl}" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLgInt}" />
    </Style>

    <Style x:Key="ButtonSecondaryXl" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
        <Setter Property="FontFamily" Value="{DynamicResource FontDisplay600}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TargetXl}" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLgInt}" />
    </Style>

    <Style x:Key="ButtonDangerXl" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
        <Setter Property="FontFamily" Value="{DynamicResource FontDisplay600}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TargetXl}" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLgInt}" />
    </Style>

    <!-- Unstyled Buttons get the outlined secondary look, never a bare text button. -->
    <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}" />

    <!-- Card (Card README; bundle .bb-card): surface-raised, radius-lg, line hairline, shadow-1. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="{StaticResource BorderHairline}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
        </Setter>
        <Setter Property="Padding" Value="{StaticResource Space4}" />
        <Setter Property="Shadow" Value="{DynamicResource Shadow1}" />
    </Style>

    <!-- Text field well (TextField README): surface-sunken, 2px line-strong, radius-md, 48 tall.
         InputFocusBehavior switches the edge for focus and errors. -->
    <Style x:Key="TextFieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="Stroke" Value="{DynamicResource LineStrong}" />
        <Setter Property="StrokeThickness" Value="{StaticResource BorderControl}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{StaticResource RadiusMd}" />
        </Setter>
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Target}" />
    </Style>

    <!-- Numbered step marker (Session "Get Started"): a 32px brand-soft circle, brand number. -->
    <Style x:Key="StepNumber" TargetType="Border">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BrandSoft}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{StaticResource RadiusFull}" />
        </Setter>
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>

    <Style x:Key="StepNumberText" TargetType="Label" BasedOn="{StaticResource TypeLabel}">
        <Setter Property="TextColor" Value="{DynamicResource Brand}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <!-- The label line height adds uneven space around the digit and sits it off-center. -->
        <Setter Property="LineHeight" Value="1" />
    </Style>

    <!-- A Lucide glyph drawn in the label's TextColor (README Iconography). Decorative:
         pair it with words, which carry the meaning for screen readers. -->
    <Style x:Key="IconLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="FontSize" Value="{StaticResource IconM}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <!-- The implicit Label style's body line height would sit the glyph low on iOS. -->
        <Setter Property="LineHeight" Value="1" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource TypeBody}" />

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans400}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Target}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans400}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Target}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Brand}" />
        <Setter Property="ThumbColor" Value="{DynamicResource OnBrand}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Target}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource Target}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Brand}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Brand}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource Line}" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Ink}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource InkDisabled}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Brand}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Brand}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource InkMuted}" />
    </Style>

</ResourceDictionary>
