<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- iPhone only (1). Declaring iPad (2) obliges the app to offer all four
	     orientations for multitasking, which App Store validation rejects
	     against a portrait lock (ITMS-90474). The lock is deliberate: the
	     bottom-anchored controls are laid out for tremor-friendly reach.
	     UIRequiresFullScreen is not an escape hatch; it is ignored for apps
	     built against the iOS 26 SDK. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- iOS 27 refuses to launch apps without a scene manifest. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>BuzzahBuddy uses Bluetooth to connect to your BlueBuzzah gloves and run sessions.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>BuzzahBuddy uses Bluetooth to connect to your BlueBuzzah gloves and run sessions.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<!-- Export compliance. Without this key every TestFlight build stalls at
	     "Missing Compliance" until answered by hand in App Store Connect.
	     false = the app uses no non-exempt encryption: BLE plus the OS's own
	     TLS only, no custom or proprietary cryptography. Revisit if the app
	     ever ships its own crypto. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Siri phrases say \(.applicationName); these let "Glove", "Gloves" or "BlueBuzzah"
	     stand in for BuzzahBuddy ("Check Glove battery"). Three is iOS's limit per language. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Glove</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Gloves</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>BlueBuzzah</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>blue buzzah</string>
		</dict>
	</array>
</dict>
</plist>
