<?xml version="1.0" encoding="utf-8" ?>
<!-- Gloves screen (buzzahbuddy.md Gloves screen, Settings). Connected: GloveStatus pair with
     firmware, the profile list, device options and one batched Apply (plan choice PC2).
     Not connected: scan and connect. Each view has one banner slot. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BuzzahBuddy.ViewModels"
             xmlns:models="clr-namespace:BuzzahBuddy.Models"
             xmlns:controls="clr-namespace:BuzzahBuddy.Views.Controls"
             xmlns:helpers="clr-namespace:BuzzahBuddy.Helpers"
             x:Class="BuzzahBuddy.Views.DeviceListPage"
             x:DataType="vm:DeviceListViewModel"
             x:Name="page"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="*,Auto" Padding="16,0,16,16">

        <!-- Connected -->
        <ScrollView Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ConnectionInfo.IsConnected}">
            <VerticalStackLayout Spacing="{StaticResource Space6}" Padding="0,0,0,8">
                <Label Text="Gloves" Style="{StaticResource TypeHeadline}" SemanticProperties.HeadingLevel="Level1" />

                <controls:Banner IsVisible="{Binding Settings.BannerVisible}"
                                 Tone="{Binding Settings.BannerTone}"
                                 Title="{Binding Settings.BannerTitle}"
                                 Message="{Binding Settings.BannerMessage}"
                                 ActionText="{Binding Settings.BannerActionText}"
                                 ActionCommand="{Binding Settings.ShowFirmwareUpdateCommand}"
                                 Announce="True" />

                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <!-- Only the primary reports firmware, so it sits above the pair, not in a card. It wraps
                         so the version moves to the next line at large text sizes instead of being cut off. -->
                    <FlexLayout Wrap="Wrap"
                                AlignItems="Center"
                                IsVisible="{Binding Settings.FirmwareVersion, Converter={StaticResource IsNotNullConverter}}"
                                SemanticProperties.Description="{Binding Settings.FirmwareDescription}"
                                AutomationId="FirmwareVersion">
                        <Label Text="{x:Static helpers:LucideIcons.Cpu}"
                               Style="{StaticResource IconLabel}"
                               FontSize="{StaticResource IconS}"
                               TextColor="{DynamicResource InkMuted}"
                               Margin="0,0,8,0" />
                        <!-- Line height 1 on the text: the body line height sits it below the icon on iOS. -->
                        <Label Text="Firmware"
                               Style="{StaticResource TypeBodyS}"
                               TextColor="{DynamicResource InkMuted}"
                               LineHeight="1"
                               Margin="0,0,8,0"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{Binding Settings.FirmwareVersion, StringFormat='v{0}'}"
                               Style="{StaticResource TypeCodeS}"
                               LineHeight="1"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <!-- Not tappable (StatusBadge README); the banner's "How to Update" is. -->
                        <controls:StatusBadge Tone="Warning"
                                              Text="Outdated"
                                              Margin="8,0,0,0"
                                              IsVisible="{Binding Settings.FirmwareOutdated}" />
                    </FlexLayout>
                    <controls:GloveStatusPair Primary="{Binding Settings.PrimaryGlove}" Secondary="{Binding Settings.SecondaryGlove}" />
                    <Button Text="Refresh Device Info"
                            Style="{StaticResource ButtonQuiet}"
                            ContentLayout="Left,8"
                            Command="{Binding Settings.RefreshDeviceInfoCommand}"
                            IsEnabled="{Binding Settings.IsNotRefreshingDeviceInfo}"
                            SemanticProperties.Description="Refresh Device Info"
                            AutomationId="RefreshDeviceInfoButton">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.RefreshCw}" Size="20" Color="{DynamicResource Brand}" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>

                <!-- Therapy profile: a single-choice list (plan choice PC27) -->
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Label Text="Therapy Profile" Style="{StaticResource TypeTitleL}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="Pick a profile, then tap Apply Settings. Your gloves restart to use it."
                           Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings.AvailableProfiles}" Spacing="{StaticResource Space3}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileItemViewModel">
                                <Border Style="{StaticResource Card}"
                                        Shadow="{x:Null}"
                                        SemanticProperties.Description="{Binding AccessibleText}"
                                        AutomationId="{Binding ProfileId, StringFormat='ProfileRow_{0}'}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brand}" />
                                            <Setter Property="StrokeThickness" Value="{StaticResource BorderControl}" />
                                            <Setter Property="BackgroundColor" Value="{DynamicResource BrandSoft}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <!-- x:DataType cleared + x:Reference: RelativeSource doesn't resolve in item templates on device. -->
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer x:DataType="{x:Null}"
                                                              Command="{Binding Source={x:Reference page}, Path=BindingContext.Settings.SelectProfileCommand}"
                                                              CommandParameter="{Binding}"
                                                              Tapped="OnCardTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space4}" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                        <!-- Radio indicator: empty 2px ring, or a filled circle with a check -->
                                        <Border WidthRequest="32" HeightRequest="32" VerticalOptions="Center"
                                                Stroke="{DynamicResource LineStrong}" StrokeThickness="{StaticResource BorderControl}"
                                                BackgroundColor="Transparent" InputTransparent="True"
                                                AutomationProperties.IsInAccessibleTree="False">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="{StaticResource RadiusFull}" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource Brand}" />
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Brand}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Style="{StaticResource IconInShape}" FontSize="20" HorizontalOptions="Center"
                                                   Text="{x:Static helpers:LucideIcons.Check}" TextColor="{DynamicResource OnBrand}"
                                                   IsVisible="{Binding IsSelected}" />
                                        </Border>
                                        <!-- The name shares the indicator's row so the two center on each other; line height 1
                                             stops iOS from sitting the name low. The card itself carries the spoken text. -->
                                        <Label Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource TypeTitleM}" LineHeight="1"
                                               VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Style="{StaticResource TypeBodyS}"
                                               TextColor="{DynamicResource InkMuted}" AutomationProperties.IsInAccessibleTree="False" />
                                        <Button Grid.Row="2" Grid.Column="1"
                                                Text="Edit Settings"
                                                Style="{StaticResource ButtonQuiet}"
                                                HorizontalOptions="End"
                                                Margin="0,12,0,0"
                                                IsVisible="{Binding CanEditParameters}"
                                                SemanticProperties.Description="Edit Settings"
                                                AutomationId="{Binding EditParametersAutomationId}">
                                            <Button.Command>
                                                <Binding Source="{x:Reference page}" Path="BindingContext.Settings.EditCustomParametersCommand" x:DataType="{x:Null}" />
                                            </Button.Command>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Device options -->
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Label Text="Device Options" Style="{StaticResource TypeTitleL}" SemanticProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource Card}" Padding="0,8" IsVisible="{Binding Settings.TherapyLedLoaded}">
                        <controls:SwitchRow Label="Turn Off the Glove Light during Sessions"
                                            Description="The status light stays dark so it won't distract you."
                                            IsToggled="{Binding Settings.TherapyLedOff}"
                                            IsEnabled="{Binding Settings.TherapyLedBusy, Converter={StaticResource InvertedBoolConverter}}"
                                            AutomationId="TherapyLedOffSwitch" />
                    </Border>
                </VerticalStackLayout>

                <!-- Outside Device Options, so it sits evenly between the card and Apply Settings. -->
                <Button Text="Test Motors"
                        Style="{StaticResource ButtonSecondary}"
                        ContentLayout="Left,8"
                        Command="{Binding Settings.NavigateToCalibrationCommand}"
                        IsEnabled="{Binding Settings.IsSessionInactive}"
                        SemanticProperties.Description="Test Motors"
                        AutomationId="CalibrateMotorsButton">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Vibrate}" Size="20" Color="{DynamicResource Brand}" />
                    </Button.ImageSource>
                </Button>

                <!-- Apply: the screen's one primary action. Available whenever no session is running or
                     paused (owner's choice): with nothing changed it applies everything again, which
                     helps when troubleshooting. -->
                <VerticalStackLayout Spacing="{StaticResource Space2}">
                    <Button Text="Apply Settings"
                            Style="{StaticResource ButtonPrimaryXl}"
                            ContentLayout="Left,8"
                            Command="{Binding Settings.ApplySettingsCommand}"
                            SemanticProperties.Description="Apply Settings"
                            AutomationId="ApplyDeviceSettingsButton">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.HardDriveDownload}" Size="24" Color="{DynamicResource OnBrand}" />
                        </Button.ImageSource>
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                <Binding Path="ConnectionInfo.IsConnected" />
                                <Binding Path="Settings.IsSessionInactive" />
                                <Binding Path="Settings.IsNotBusy" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                </VerticalStackLayout>

                <Button Text="Disconnect"
                        Style="{StaticResource ButtonDangerXl}"
                        ContentLayout="Left,8"
                        Command="{Binding DisconnectCommand}"
                        SemanticProperties.Description="Disconnect"
                        AutomationId="DisconnectButton">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Unplug}" Size="24" Color="{DynamicResource OnStatus}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Not connected: scan and connect -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto" IsVisible="{Binding Settings.ShowDisconnectedView}">
            <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource Space6}" Margin="0,0,0,16">
                <Label Text="Gloves" Style="{StaticResource TypeHeadline}" SemanticProperties.HeadingLevel="Level1" />
                <controls:Banner IsVisible="{Binding BannerVisible}"
                                 Tone="{Binding BannerTone}"
                                 Title="{Binding BannerTitle}"
                                 Message="{Binding BannerMessage}"
                                 Detail="{Binding BannerDetail}"
                                 ActionText="{Binding BannerActionText}"
                                 ActionCommand="{Binding BannerActionCommand}"
                                 ActionAtEnd="{Binding BannerActionAtEnd}"
                                 Announce="True" />
            </VerticalStackLayout>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshDevicesCommand}">
                <CollectionView ItemsSource="{Binding AvailableDevices}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.EmptyView>
                        <Grid>
                            <VerticalStackLayout Spacing="{StaticResource Space3}" VerticalOptions="Center" IsVisible="{Binding ShowReadyState}">
                                <Label Style="{StaticResource IconLabel}" FontSize="32" HorizontalOptions="Center"
                                       Text="{x:Static helpers:LucideIcons.Bluetooth}" TextColor="{DynamicResource Brand}" />
                                <Label Text="Find Your Gloves" Style="{StaticResource TypeTitleM}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="Turn on both gloves, then tap Scan for Gloves." HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource Space3}" VerticalOptions="Center" IsVisible="{Binding ShowScanning}">
                                <controls:RadarSweep IsRunning="{Binding ShowScanning}" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" />
                                <Label Text="Scanning for Gloves…" Style="{StaticResource TypeTitleM}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding ScanningHint}" HorizontalTextAlignment="Center" TextColor="{DynamicResource InkMuted}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource Space3}" VerticalOptions="Center" IsVisible="{Binding ShowNoResultsState}">
                                <Label Style="{StaticResource IconLabel}" FontSize="32" HorizontalOptions="Center"
                                       Text="{x:Static helpers:LucideIcons.Bluetooth}" TextColor="{DynamicResource Brand}" />
                                <Label Text="No Gloves Found" Style="{StaticResource TypeTitleM}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2" />
                                <Border Style="{StaticResource Card}" Shadow="{x:Null}">
                                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                                        <Label Text="Check these, then scan again:" Style="{StaticResource TypeBodyStrong}" />
                                        <Label Text="• Bluetooth is on." />
                                        <Label Text="• Both gloves are charged and turned on." />
                                        <Label Text="• Your phone is within 30 feet of the gloves." />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GloveDevice">
                            <!-- The whole card connects, like the Session cards; "Connect ›" says so and turns gray
                                 while a connection is under way (ConnectAsync ignores taps then). x:DataType
                                 cleared + x:Reference: RelativeSource silently fails in recycled CollectionView
                                 containers on device. Don't convert back. -->
                            <Border Style="{StaticResource Card}"
                                    Margin="0,0,0,12"
                                    SemanticProperties.Hint="Connects to these gloves"
                                    AutomationId="ConnectDeviceButton">
                                <SemanticProperties.Description>
                                    <MultiBinding StringFormat="{}{0}, {1}">
                                        <Binding Path="DisplayName" />
                                        <Binding Path="SignalStrengthDisplay" />
                                    </MultiBinding>
                                </SemanticProperties.Description>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer x:DataType="{x:Null}"
                                                          Command="{Binding Source={x:Reference page}, Path=BindingContext.ConnectCommand}"
                                                          CommandParameter="{Binding}"
                                                          Tapped="OnCardTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}" AutomationProperties.ExcludedWithChildren="True">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <!-- Line height 1: the title line height would sit both lines off center (GlovesSummaryCard). -->
                                        <Label Text="{Binding DisplayName}" Style="{StaticResource TypeTitleM}" LineHeight="1" />
                                        <HorizontalStackLayout Spacing="{StaticResource Space1}">
                                            <Label Text="{Binding SignalGlyph}" Style="{StaticResource IconLabel}" FontSize="{StaticResource IconS}"
                                                   TextColor="{DynamicResource InkMuted}" VerticalOptions="Center" />
                                            <Label Text="{Binding SignalStrengthDisplay}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}"
                                                   LineHeight="1" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <controls:ChevronLink Grid.Column="1"
                                                          x:DataType="{x:Null}"
                                                          Text="Connect"
                                                          IsEnabled="{Binding Source={x:Reference page}, Path=BindingContext.IsConnecting, Converter={StaticResource InvertedBoolConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <HorizontalStackLayout Grid.Row="2" Spacing="{StaticResource Space2}" HorizontalOptions="Center" Margin="0,8,0,0"
                                   IsVisible="{Binding ShowScanningWithResults}">
                <controls:RadarSweep IsRunning="{Binding ShowScanningWithResults}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                <!-- Line height 1: the body line height sits the text below the radar on iOS. -->
                <Label Text="Still Scanning for More Gloves…" Style="{StaticResource TypeBodyS}" LineHeight="1" VerticalOptions="Center" AutomationId="StillScanningLabel" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Primary action in easy reach at the bottom -->
        <Button Grid.Row="1"
                Text="{Binding ScanButtonText}"
                Style="{StaticResource ButtonPrimaryXl}"
                Command="{Binding ToggleScanCommand}"
                ContentLayout="Left,8"
                Margin="0,12,0,0"
                IsVisible="{Binding Settings.ShowDisconnectedView}"
                SemanticProperties.Description="{Binding ScanButtonText}"
                AutomationId="ScanToggleButton">
            <Button.ImageSource>
                <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Radar}" Size="24" Color="{DynamicResource OnBrand}" />
            </Button.ImageSource>
            <!-- Radar means "scan"; Stop Scanning takes the stop glyph. -->
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding ShowScanning}" Value="True">
                    <Setter Property="ImageSource">
                        <Setter.Value>
                            <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Square}" Size="24" Color="{DynamicResource OnBrand}" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <!-- Connecting overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Margin="-16,-16,-16,-16" BackgroundColor="{DynamicResource Scrim}" IsVisible="{Binding IsConnecting}">
            <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource SurfaceOverlay}" Shadow="{DynamicResource Shadow3}"
                    Margin="32,0" VerticalOptions="Center" Padding="{StaticResource Space6}">
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <ActivityIndicator IsRunning="{Binding IsConnecting}" HeightRequest="32" WidthRequest="32"
                                       AutomationProperties.IsInAccessibleTree="False" />
                    <Label Text="Connecting to Your Gloves…" Style="{StaticResource TypeTitleM}" HorizontalTextAlignment="Center" />
                    <Label Text="This can take up to 15 seconds." Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
