<?xml version="1.0" encoding="utf-8" ?>
<!-- First run: the medical disclaimer and the implanted-device notice, verbatim (the owner's
     legal text), before anything else. Shown once; back and swipe can't skip it. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuzzahBuddy.Views.WelcomePage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container">
    <Grid RowDefinitions="*,Auto" Padding="{StaticResource Space4}">
        <ScrollView>
            <VerticalStackLayout Spacing="{StaticResource Space6}" Padding="0,48,0,24">
                <Label Text="Welcome to BuzzahBuddy"
                       Style="{StaticResource TypeHeadline}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="BuzzahBuddy runs sessions on your BlueBuzzah gloves. Read these two notes before your first session."
                       Style="{StaticResource TypeBodyL}" />
                <Label Text="BlueBuzzah devices are not FDA approved medical devices and not intended to diagnose, treat, cure, or prevent any disease. The information provided through BlueBuzzah is for general wellness purposes only and not a substitute for professional medical advice, diagnosis, or treatment." />
                <Label Text="Important: People with implanted electrodes from deep brain stimulation (DBS), heart pacemakers, or other internal electronic devices should take special precautions around all electronic devices, including BlueBuzzah. Consult your physician before use." />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1"
                Text="Continue"
                Style="{StaticResource ButtonPrimary}"
                Margin="0,12,0,0"
                Clicked="OnContinueClicked"
                SemanticProperties.Description="Continue"
                AutomationId="WelcomeContinueButton" />
    </Grid>
</ContentPage>
