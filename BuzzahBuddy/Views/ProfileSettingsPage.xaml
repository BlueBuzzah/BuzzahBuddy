<?xml version="1.0" encoding="utf-8" ?>
<!-- Custom profile editor. Labeled fields with the range as a hint and errors tied to each
     field (TextField README). Text fields, not steppers: the firmware takes 1 ms / 1% steps,
     so every range is far over ~20 steps (plan choice PC20). Ranges mirror firmware
     include/config.h PARAM_* (cross-repo contract). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BuzzahBuddy.ViewModels"
             xmlns:controls="clr-namespace:BuzzahBuddy.Views.Controls"
             xmlns:behaviors="clr-namespace:BuzzahBuddy.Behaviors"
             xmlns:helpers="clr-namespace:BuzzahBuddy.Helpers"
             x:Class="BuzzahBuddy.Views.ProfileSettingsPage"
             x:DataType="vm:ProfileSettingsViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="Container">

    <ScrollView>
        <VerticalStackLayout Padding="16,0,16,24" Spacing="{StaticResource Space6}">
            <Label Text="These settings make up your Custom profile. They're saved on this phone, and your gloves get them when you pick Custom and tap Apply Settings." />

            <controls:Banner IsVisible="{Binding DeviatesBannerVisible}"
                             Tone="Warning"
                             Title="These Settings Differ from the Study"
                             Message="They're within what the gloves accept, but no study has tested them."
                             Announce="True" />

            <VerticalStackLayout Spacing="{StaticResource Space6}" IsVisible="{Binding IsLoaded}">
                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label Text="Buzz Length" Style="{StaticResource TypeLabel}" AutomationProperties.IsInAccessibleTree="False" />
                        <Border Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior HasError="{Binding TimeOnError, Converter={StaticResource IsNotNullConverter}}" />
                            </Border.Behaviors>
                            <Entry Text="{Binding TimeOnMsText}"
                                   Keyboard="Numeric"
                                   SemanticProperties.Description="Buzz Length"
                                   SemanticProperties.Hint="{Binding TimeOnError}"
                                   AutomationId="TimeOnEntry" />
                        </Border>
                        <Label Text="50 to 200ms" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding TimeOnError, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.OctagonAlert}" TextColor="{DynamicResource Danger}" />
                            <Label Text="{Binding TimeOnError}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource Danger}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label Text="Pause between Buzzes" Style="{StaticResource TypeLabel}" AutomationProperties.IsInAccessibleTree="False" />
                        <Border Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior HasError="{Binding TimeOffError, Converter={StaticResource IsNotNullConverter}}" />
                            </Border.Behaviors>
                            <Entry Text="{Binding TimeOffMsText}"
                                   Keyboard="Numeric"
                                   SemanticProperties.Description="Pause between Buzzes"
                                   SemanticProperties.Hint="{Binding TimeOffError}"
                                   AutomationId="TimeOffEntry" />
                        </Border>
                        <Label Text="30 to 200ms" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding TimeOffError, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.OctagonAlert}" TextColor="{DynamicResource Danger}" />
                            <Label Text="{Binding TimeOffError}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource Danger}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding DerivedTimingText}"
                           Style="{StaticResource TypeBodyS}"
                           TextColor="{DynamicResource InkMuted}"
                           AutomationId="DerivedTimingLabel" />

                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label Text="Session Length" Style="{StaticResource TypeLabel}" AutomationProperties.IsInAccessibleTree="False" />
                        <Border Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior HasError="{Binding SessionError, Converter={StaticResource IsNotNullConverter}}" />
                            </Border.Behaviors>
                            <Entry Text="{Binding SessionMinutesText}"
                                   Keyboard="Numeric"
                                   SemanticProperties.Description="Session Length"
                                   SemanticProperties.Hint="{Binding SessionError}"
                                   AutomationId="SessionEntry" />
                        </Border>
                        <Label Text="1 to 240 minutes" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding SessionError, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.OctagonAlert}" TextColor="{DynamicResource Danger}" />
                            <Label Text="{Binding SessionError}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource Danger}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label Text="Softest Buzz" Style="{StaticResource TypeLabel}" AutomationProperties.IsInAccessibleTree="False" />
                        <Border Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior HasError="{Binding AmplitudeMinError, Converter={StaticResource IsNotNullConverter}}" />
                            </Border.Behaviors>
                            <Entry Text="{Binding AmplitudeMinText}"
                                   Keyboard="Numeric"
                                   SemanticProperties.Description="Softest Buzz"
                                   SemanticProperties.Hint="{Binding AmplitudeMinError}"
                                   AutomationId="AmplitudeMinEntry" />
                        </Border>
                        <Label Text="20 to 100%" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding AmplitudeMinError, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.OctagonAlert}" TextColor="{DynamicResource Danger}" />
                            <Label Text="{Binding AmplitudeMinError}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource Danger}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label Text="Strongest Buzz" Style="{StaticResource TypeLabel}" AutomationProperties.IsInAccessibleTree="False" />
                        <Border Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior HasError="{Binding AmplitudeMaxError, Converter={StaticResource IsNotNullConverter}}" />
                            </Border.Behaviors>
                            <Entry Text="{Binding AmplitudeMaxText}"
                                   Keyboard="Numeric"
                                   SemanticProperties.Description="Strongest Buzz"
                                   SemanticProperties.Hint="{Binding AmplitudeMaxError}"
                                   AutomationId="AmplitudeMaxEntry" />
                        </Border>
                        <Label Text="20 to 100%" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding AmplitudeMaxError, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.OctagonAlert}" TextColor="{DynamicResource Danger}" />
                            <Label Text="{Binding AmplitudeMaxError}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource Danger}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label Text="Timing Variation" Style="{StaticResource TypeLabel}" AutomationProperties.IsInAccessibleTree="False" />
                        <Border Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior HasError="{Binding JitterError, Converter={StaticResource IsNotNullConverter}}" />
                            </Border.Behaviors>
                            <Entry Text="{Binding JitterText}"
                                   Keyboard="Numeric"
                                   SemanticProperties.Description="Timing Variation"
                                   SemanticProperties.Hint="{Binding JitterError}"
                                   AutomationId="JitterEntry" />
                        </Border>
                        <Label Text="0 to 50%" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding JitterError, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.OctagonAlert}" TextColor="{DynamicResource Danger}" />
                            <Label Text="{Binding JitterError}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource Danger}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                               IsVisible="{Binding EffectiveJitterCapText, Converter={StaticResource IsNotNullConverter}}">
                            <Label Style="{StaticResource IconLabel}" FontSize="20" VerticalOptions="Start"
                                   Text="{x:Static helpers:LucideIcons.TriangleAlert}" TextColor="{DynamicResource Warning}" />
                            <Label Text="{Binding EffectiveJitterCapText}" Style="{StaticResource TypeBodyS}"
                                   TextColor="{DynamicResource Warning}" AutomationId="JitterCapLabel" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="0,8">
                    <controls:SwitchRow Label="Same Pattern on Both Gloves"
                                        Description="Both gloves buzz the same fingers at the same time."
                                        IsToggled="{Binding Mirror}"
                                        AutomationId="MirrorSwitch" />
                </Border>

                <VerticalStackLayout Spacing="{StaticResource TargetGap}">
                    <Button Text="Use Study Settings"
                            Style="{StaticResource ButtonQuiet}"
                            Command="{Binding ResetToDefaultsCommand}"
                            SemanticProperties.Description="Use Study Settings"
                            AutomationId="ResetToDefaultsButton" />
                    <!-- Saving goes back to the Gloves page, so no "Saved" badge. -->
                    <Button Text="Save"
                            Style="{StaticResource ButtonPrimary}"
                            ContentLayout="Left,8"
                            Command="{Binding SaveCommand}"
                            SemanticProperties.Description="Save"
                            AutomationId="SaveProfileSettingsButton">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Save}" Size="20" Color="{DynamicResource OnBrand}" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
