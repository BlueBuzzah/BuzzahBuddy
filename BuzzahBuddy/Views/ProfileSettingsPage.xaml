<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BuzzahBuddy.ViewModels"
             xmlns:controls="clr-namespace:BuzzahBuddy.Views.Controls"
             xmlns:behaviors="clr-namespace:BuzzahBuddy.Behaviors"
             x:Class="BuzzahBuddy.Views.ProfileSettingsPage"
             x:DataType="vm:ProfileSettingsViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="Container">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Custom Profile"
                   Style="{StaticResource TypeHeadline}"
                   SemanticProperties.HeadingLevel="Level1"
                   HorizontalOptions="Center" />

            <!-- Connection Status Banner -->
            <controls:ConnectionStatusBanner
                ConnectionState="{Binding ConnectionInfo.ConnectionState}"
                DeviceName="{Binding ConnectionInfo.ConnectedDeviceName}" />

            <!-- Not connected / not loaded guidance -->
            <Label Text="Connect to a BlueBuzzah glove to view and adjust the Custom profile parameters."
                   IsVisible="{Binding IsLoaded, Converter={StaticResource InvertedBoolConverter}}"
                   Style="{StaticResource TypeBody}"
                   TextColor="{DynamicResource InkMuted}"
                   SemanticProperties.Description="Connect to a glove to view and adjust profile settings" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               SemanticProperties.Description="Working" />

            <!-- Editor -->
            <Border Style="{StaticResource Card}" Padding="15"
                    IsVisible="{Binding IsLoaded}">

                <VerticalStackLayout Spacing="15">

                    <Label Text="These parameters define the Custom therapy profile. The gloves keep them after a restart."
                           Style="{StaticResource TypeBody}"
                           TextColor="{DynamicResource InkMuted}"
                           SemanticProperties.Description="The gloves keep these parameters after a restart" />

                    <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="15" RowSpacing="12">

                        <Label Style="{StaticResource TypeBody}" Grid.Row="0" Grid.Column="0" Text="Burst Duration (ms, 50-200)" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior />
                            </Border.Behaviors>
                            <Entry Text="{Binding TimeOnMsText}"
                                   Keyboard="Numeric"
                                   MinimumHeightRequest="48"
                                   HorizontalTextAlignment="End"
                                   SemanticProperties.Description="Vibration burst duration in milliseconds, 50 to 200"
                                   AutomationId="TimeOnEntry" />
                        </Border>

                        <Label Style="{StaticResource TypeBody}" Grid.Row="1" Grid.Column="0" Text="Gap Between Bursts (ms, 30-200)" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior />
                            </Border.Behaviors>
                            <Entry Text="{Binding TimeOffMsText}"
                                   Keyboard="Numeric"
                                   MinimumHeightRequest="48"
                                   HorizontalTextAlignment="End"
                                   SemanticProperties.Description="Gap between vibration bursts in milliseconds, 30 to 200"
                                   AutomationId="TimeOffEntry" />
                        </Border>

                        <!-- Derived coordinated-reset timing, updates as the fields change -->
                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding DerivedTimingText}"
                               Style="{StaticResource TypeBody}"
                               TextColor="{DynamicResource InkMuted}"
                               SemanticProperties.Description="{Binding DerivedTimingText}"
                               AutomationId="DerivedTimingLabel" />

                        <Label Style="{StaticResource TypeBody}" Grid.Row="3" Grid.Column="0" Text="Session (min, 1-240)" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior />
                            </Border.Behaviors>
                            <Entry Text="{Binding SessionMinutesText}"
                                   Keyboard="Numeric"
                                   MinimumHeightRequest="48"
                                   HorizontalTextAlignment="End"
                                   SemanticProperties.Description="Session duration in minutes, 1 to 240"
                                   AutomationId="SessionEntry" />
                        </Border>

                        <Label Style="{StaticResource TypeBody}" Grid.Row="4" Grid.Column="0" Text="Amplitude Min (%, 20-100)" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior />
                            </Border.Behaviors>
                            <Entry Text="{Binding AmplitudeMinText}"
                                   Keyboard="Numeric"
                                   MinimumHeightRequest="48"
                                   HorizontalTextAlignment="End"
                                   SemanticProperties.Description="Minimum amplitude percentage, 20 to 100"
                                   AutomationId="AmplitudeMinEntry" />
                        </Border>

                        <Label Style="{StaticResource TypeBody}" Grid.Row="5" Grid.Column="0" Text="Amplitude Max (%, 20-100)" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior />
                            </Border.Behaviors>
                            <Entry Text="{Binding AmplitudeMaxText}"
                                   Keyboard="Numeric"
                                   MinimumHeightRequest="48"
                                   HorizontalTextAlignment="End"
                                   SemanticProperties.Description="Maximum amplitude percentage, 20 to 100"
                                   AutomationId="AmplitudeMaxEntry" />
                        </Border>

                        <Label Style="{StaticResource TypeBody}" Grid.Row="6" Grid.Column="0" Text="Jitter (%, 0-50)" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource TextFieldBorder}">
                            <Border.Behaviors>
                                <behaviors:InputFocusBehavior />
                            </Border.Behaviors>
                            <Entry Text="{Binding JitterText}"
                                   Keyboard="Numeric"
                                   MinimumHeightRequest="48"
                                   HorizontalTextAlignment="End"
                                   SemanticProperties.Description="Timing jitter percentage, 0 to 50"
                                   AutomationId="JitterEntry" />
                        </Border>
                    </Grid>

                    <!-- Shown only when the requested jitter exceeds what this timing allows -->
                    <Label Text="{Binding EffectiveJitterCapText}"
                           IsVisible="{Binding EffectiveJitterCapText, Converter={StaticResource IsNotNullConverter}}"
                           Style="{StaticResource TypeBody}"
                           TextColor="{DynamicResource Warning}"
                           SemanticProperties.Description="{Binding EffectiveJitterCapText}"
                           AutomationId="JitterCapLabel" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15" MinimumHeightRequest="48">
                        <Label Style="{StaticResource TypeBody}" Grid.Column="0"
                               Text="Mirror Pattern Between Gloves"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding Mirror}"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Mirror pattern between primary and secondary glove"
                                SemanticProperties.Hint="Double tap to toggle pattern mirroring"
                                AutomationId="MirrorSwitch" />
                    </Grid>

                    <!-- Deviation from the one configuration the research validated -->
                    <Label Text="These settings differ from the parameters used in the published vibrotactile therapy study. They are within the range the gloves accept, but their therapeutic effect has not been studied."
                           IsVisible="{Binding DeviatesFromResearchDefaults}"
                           Style="{StaticResource TypeBody}"
                           TextColor="{DynamicResource Warning}"
                           SemanticProperties.Description="These settings differ from the parameters used in the published therapy study"
                           AutomationId="ResearchDeviationLabel" />

                    <Button Text="Save to Gloves"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource ButtonPrimary}"
                            SemanticProperties.Description="Apply the edited profile settings to the connected gloves"
                            SemanticProperties.Hint="Double tap to send the settings to the gloves"
                            AutomationId="ApplyProfileSettingsButton" />

                    <Button Text="Reload from Gloves"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Description="Discard edits and reload the current settings from the gloves"
                            SemanticProperties.Hint="Double tap to reload settings from the gloves"
                            AutomationId="ReloadProfileSettingsButton" />

                    <Button Text="Use Research Defaults"
                            Command="{Binding ResetToDefaultsCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource ButtonQuiet}"
                            SemanticProperties.Description="Fill the form with the parameters used in the published vibrotactile therapy study"
                            SemanticProperties.Hint="Double tap to fill the form with the study parameters; nothing is sent until you save"
                            AutomationId="ResetToDefaultsButton" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
