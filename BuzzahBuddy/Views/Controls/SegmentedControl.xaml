<?xml version="1.0" encoding="utf-8" ?>
<!-- SegmentedControl (SegmentedControl README; bundle .bb-seg): two to four short options,
     all visible. The selected one is a brand fill, bold, with a check: three cues, not color. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuzzahBuddy.Views.Controls.SegmentedControl">
    <VerticalStackLayout Spacing="{StaticResource Space2}">
        <Label x:Name="LabelText" Style="{StaticResource TypeLabel}" />
        <Border BackgroundColor="{DynamicResource SurfaceSunken}"
                Stroke="{DynamicResource LineStrong}"
                StrokeThickness="{StaticResource BorderHairline}"
                Padding="{StaticResource Space1}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid x:Name="Track" ColumnSpacing="{StaticResource Space1}" />
        </Border>
    </VerticalStackLayout>
</ContentView>
