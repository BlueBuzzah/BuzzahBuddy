<?xml version="1.0" encoding="utf-8" ?>
<!-- Session screen (buzzahbuddy.md Session screen): a tappable summary of both gloves (the
     full cards are on Gloves), SessionRing, then the session controls at the bottom (Start,
     or Pause/Resume and Stop). One banner slot. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BuzzahBuddy.ViewModels"
             xmlns:controls="clr-namespace:BuzzahBuddy.Views.Controls"
             xmlns:helpers="clr-namespace:BuzzahBuddy.Helpers"
             x:Class="BuzzahBuddy.Views.GloveControlPage"
             x:DataType="vm:GloveControlViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="*,Auto" Padding="16,0,16,16">
        <ScrollView x:Name="Scroller">
            <!-- At least the viewport's height (code-behind), so Get Started centers in the space
                 between the title and Scan for Gloves. No row spacing: an even gap above and below
                 the card; the connected content takes its 24 as a margin. -->
            <Grid x:Name="ScrollContent" RowDefinitions="Auto,*">
                <VerticalStackLayout Spacing="{StaticResource Space6}">
                    <Label Text="Session"
                           Style="{StaticResource TypeHeadline}"
                           SemanticProperties.HeadingLevel="Level1" />

                    <controls:Banner IsVisible="{Binding BannerVisible}"
                                     Tone="{Binding BannerTone}"
                                     Title="{Binding BannerTitle}"
                                     Message="{Binding BannerMessage}"
                                     ActionText="{Binding BannerActionText}"
                                     ActionCommand="{Binding NavigateToDevicesCommand}"
                                     Announce="True"
                                     AutomationId="SessionBanner" />
                </VerticalStackLayout>

                <!-- Not connected: how to get started -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        VerticalOptions="Center"
                        IsVisible="{Binding ConnectionInfo.IsConnected, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="{StaticResource Space4}">
                        <Label Text="Get Started"
                               Style="{StaticResource TypeTitleM}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="{StaticResource Space4}" RowSpacing="{StaticResource Space4}">
                            <Border Style="{StaticResource StepNumber}">
                                <Label Text="1" Style="{StaticResource StepNumberText}" />
                            </Border>
                            <!-- LineHeight 1 matches StepNumberText (same font and size), so the text and
                                 the digit center the same way on both platforms. -->
                            <Label Grid.Column="1" Text="Turn On Both Gloves" Style="{StaticResource TypeBodyStrong}" LineHeight="1" VerticalOptions="Center" />
                            <Border Grid.Row="1" Style="{StaticResource StepNumber}">
                                <Label Text="2" Style="{StaticResource StepNumberText}" />
                            </Border>
                            <Label Grid.Row="1" Grid.Column="1" Text="Connect to Your Gloves" Style="{StaticResource TypeBodyStrong}" LineHeight="1" VerticalOptions="Center" />
                            <Border Grid.Row="2" Style="{StaticResource StepNumber}">
                                <Label Text="3" Style="{StaticResource StepNumberText}" />
                            </Border>
                            <Label Grid.Row="2" Grid.Column="1" Text="Start a Session" Style="{StaticResource TypeBodyStrong}" LineHeight="1" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Connected -->
                <VerticalStackLayout Grid.Row="1"
                                     Margin="0,24,0,0"
                                     Spacing="{StaticResource Space6}"
                                     IsVisible="{Binding ConnectionInfo.IsConnected}">
                    <controls:GlovesSummaryCard Primary="{Binding PrimaryGlove}"
                                                Secondary="{Binding SecondaryGlove}"
                                                Command="{Binding NavigateToDevicesCommand}"
                                                AutomationId="GlovesSummary" />

                    <controls:SessionRing IsVisible="{Binding ConnectionInfo.IsConnected}"
                                          State="{Binding RingState}"
                                          Progress="{Binding RingProgress}"
                                          Time="{Binding RingTimeText}"
                                          AccessibleText="{Binding RingAccessibleText}"
                                          AutomationId="SessionTimerRing" />

                    <!-- At large text sizes Change moves under the profile so the name keeps the width. -->
                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="ProfileRow" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}" RowSpacing="{StaticResource Space3}">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Therapy Profile"
                                       Style="{StaticResource TypeBodyS}"
                                       TextColor="{DynamicResource InkMuted}"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding SelectedProfileName}" Style="{StaticResource TypeTitleM}" />
                                <Label Text="{Binding ProfileSummary}" SemanticProperties.Description="{Binding ProfileSummarySpoken}" Style="{StaticResource TypeBodyS}" TextColor="{DynamicResource InkMuted}" />
                            </VerticalStackLayout>
                            <Button x:Name="ChangeButton"
                                    Grid.Column="1"
                                    Text="Change"
                                    Style="{StaticResource ButtonQuiet}"
                                    VerticalOptions="Center"
                                    ContentLayout="Right,6"
                                    Command="{Binding NavigateToDevicesCommand}"
                                    IsEnabled="{Binding IsSessionActive, Converter={StaticResource InvertedBoolConverter}}"
                                    SemanticProperties.Description="Change"
                                    AutomationId="ChangeProfileButton">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.ChevronRight}" Size="20" Color="{DynamicResource Brand}" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- The primary action in easy reach at the bottom, as on Gloves: Scan for Gloves, or the
             session controls (Start alone, full width, or Pause/Resume and Stop side by side). -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Button Text="Scan for Gloves"
                    IsVisible="{Binding ConnectionInfo.IsConnected, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource ButtonPrimaryXl}"
                    ContentLayout="Left,8"
                    Command="{Binding ScanForGlovesCommand}"
                    SemanticProperties.Description="Scan for Gloves"
                    AutomationId="FindDevicesButton">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Radar}" Size="24" Color="{DynamicResource OnBrand}" />
                </Button.ImageSource>
            </Button>

            <!-- Session controls: xl; Start alone, full width, or Pause/Resume and Stop side by side -->
            <VerticalStackLayout Spacing="{StaticResource TargetGap}" IsVisible="{Binding ConnectionInfo.IsConnected}">
                <Button Text="Start Session"
                        Style="{StaticResource ButtonPrimaryXl}"
                        Command="{Binding StartSessionCommand}"
                        IsVisible="{Binding IsSessionActive, Converter={StaticResource InvertedBoolConverter}}"
                        IsEnabled="{Binding IsNotBusy}"
                        ContentLayout="Left,8"
                        SemanticProperties.Description="Start Session"
                        AutomationId="SessionControlButton">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Play}" Size="24" Color="{DynamicResource OnBrand}" />
                    </Button.ImageSource>
                </Button>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource TargetGap}" IsVisible="{Binding IsSessionActive}">
                    <Button Text="{Binding PauseResumeText}"
                            Style="{StaticResource ButtonSecondaryXl}"
                            Command="{Binding PauseResumeCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            ContentLayout="Left,8"
                            SemanticProperties.Description="{Binding PauseResumeText}"
                            AutomationId="PauseResumeButton">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSessionPaused}" Value="True">
                                <Setter Property="ImageSource">
                                    <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Play}" Size="24" Color="{DynamicResource Brand}" />
                                </Setter>
                            </DataTrigger>
                        </Button.Triggers>
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Pause}" Size="24" Color="{DynamicResource Brand}" />
                        </Button.ImageSource>
                    </Button>
                    <Button Grid.Column="1"
                            Text="Stop"
                            Style="{StaticResource ButtonDangerXl}"
                            Command="{Binding StopSessionCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            ContentLayout="Left,8"
                            SemanticProperties.Description="Stop"
                            AutomationId="StopSessionButton">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Square}" Size="24" Color="{DynamicResource OnStatus}" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
