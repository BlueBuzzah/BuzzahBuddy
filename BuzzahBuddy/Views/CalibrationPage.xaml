<?xml version="1.0" encoding="utf-8" ?>
<!-- Motor test: a three-step guide (strength, buzz length, each finger), with test mode
     started and ended from the bottom of the screen (accessibility.md: one-handed reach). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BuzzahBuddy.ViewModels"
             xmlns:controls="clr-namespace:BuzzahBuddy.Views.Controls"
             xmlns:helpers="clr-namespace:BuzzahBuddy.Helpers"
             x:Class="BuzzahBuddy.Views.CalibrationPage"
             x:Name="CalibrationPageRoot"
             x:DataType="vm:CalibrationViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="*,Auto" Padding="16,16,16,16">
        <ScrollView>
            <VerticalStackLayout Spacing="{StaticResource Space6}" Padding="0,0,0,16">
                <Label Text="Check that each finger motor buzzes. Pick a strength and a buzz length, then tap each finger." />

                <controls:Banner IsVisible="{Binding ShowNotConnected}"
                                 Tone="Info"
                                 Title="Connect Your Primary Glove"
                                 Message="Connect on the Gloves tab to test the motors." />
                <controls:Banner IsVisible="{Binding EndedByDisconnect}"
                                 Tone="Warning"
                                 Title="Test Mode Ended"
                                 Message="Your primary glove disconnected. Connect again on the Gloves tab."
                                 Announce="True" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsInCalibrationMode}">
                    <VerticalStackLayout Spacing="{StaticResource Space4}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{Binding StepCaption}" Style="{StaticResource TypeCaption}" TextColor="{DynamicResource InkMuted}" />
                            <Label x:Name="StepTitleLabel"
                                   Text="{Binding StepTitle}"
                                   Style="{StaticResource TypeTitleM}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding StepDescription}" />
                        </VerticalStackLayout>

                        <controls:ValueStepper IsVisible="{Binding IsStep1}"
                                               IsEnabled="{Binding CanCalibrate}"
                                               Label="Strength"
                                               Minimum="20" Maximum="100" Step="20"
                                               Unit="%"
                                               Value="{Binding Intensity}" />

                        <controls:SegmentedControl IsVisible="{Binding IsStep2}"
                                                   IsEnabled="{Binding CanCalibrate}"
                                                   Label="Buzz Length"
                                                   Options="{Binding DurationOptions}"
                                                   SelectedValue="{Binding Duration}" />

                        <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsStep3}">
                            <controls:StatusBadge Tone="Brand" Text="{Binding BuzzingText}" IsVisible="{Binding IsBuzzing}" />
                            <Label Text="Wait for the buzz to finish." Style="{StaticResource TypeCaption}"
                                   TextColor="{DynamicResource InkMuted}" IsVisible="{Binding IsBuzzing}" />
                        <Label Text="Primary Glove" Style="{StaticResource TypeTitleS}" SemanticProperties.HeadingLevel="Level3" />
                        <FlexLayout Wrap="Wrap" Margin="-6,0" BindableLayout.ItemsSource="{Binding PrimaryFingers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:FingerButtonItem">
                                    <ContentView FlexLayout.Basis="50%" Padding="6">
                                        <Button Text="{Binding Label}"
                                                Style="{StaticResource ButtonSecondary}"
                                                ContentLayout="Left,8"
                                                Command="{Binding BindingContext.BuzzFingerCommand, Source={x:Reference CalibrationPageRoot}}"
                                                CommandParameter="{Binding Index}"
                                                SemanticProperties.Description="{Binding AccessibleText}"
                                                AutomationId="{Binding AutomationId}"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:CalibrationViewModel}}, Path=CanBuzzFingers}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsTested}" Value="True">
                                                    <Setter Property="ImageSource">
                                                        <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Check}" Size="20" Color="{DynamicResource Brand}" />
                                                    </Setter>
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="Secondary Glove" Style="{StaticResource TypeTitleS}" SemanticProperties.HeadingLevel="Level3" />
                        <FlexLayout Wrap="Wrap" Margin="-6,0" BindableLayout.ItemsSource="{Binding SecondaryFingers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:FingerButtonItem">
                                    <ContentView FlexLayout.Basis="50%" Padding="6">
                                        <Button Text="{Binding Label}"
                                                Style="{StaticResource ButtonSecondary}"
                                                ContentLayout="Left,8"
                                                Command="{Binding BindingContext.BuzzFingerCommand, Source={x:Reference CalibrationPageRoot}}"
                                                CommandParameter="{Binding Index}"
                                                SemanticProperties.Description="{Binding AccessibleText}"
                                                AutomationId="{Binding AutomationId}"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:CalibrationViewModel}}, Path=CanBuzzFingers}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsTested}" Value="True">
                                                    <Setter Property="ImageSource">
                                                        <FontImageSource FontFamily="Lucide" Glyph="{x:Static helpers:LucideIcons.Check}" Size="20" Color="{DynamicResource Brand}" />
                                                    </Setter>
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource TargetGap}">
                            <Button Text="Back"
                                    Style="{StaticResource ButtonQuiet}"
                                    Command="{Binding PreviousStepCommand}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    SemanticProperties.Description="Back"
                                    AutomationId="PreviousStepButton" />
                            <Button Grid.Column="1"
                                    Text="Next"
                                    Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding NextStepCommand}"
                                    IsEnabled="{Binding CanGoNext}"
                                    SemanticProperties.Description="Next"
                                    AutomationId="NextStepButton" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom zone: test mode controls in easy reach -->
        <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource TargetGap}">
            <controls:StatusBadge Tone="Brand" Text="Test Mode On" IsVisible="{Binding IsInCalibrationMode}" AutomationId="CalibrationStatusLabel" />
            <controls:StatusBadge Tone="Neutral" Text="Test Mode Off"
                                  IsVisible="{Binding IsInCalibrationMode, Converter={StaticResource InvertedBoolConverter}}" />
            <Button Text="Start Test Mode"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding EnterCalibrationModeCommand}"
                    IsVisible="{Binding IsInCalibrationMode, Converter={StaticResource InvertedBoolConverter}}"
                    IsEnabled="{Binding ConnectionInfo.IsConnected}"
                    SemanticProperties.Description="Start Test Mode"
                    AutomationId="EnterCalibrationButton" />
            <Button Text="End Test Mode"
                    Style="{StaticResource ButtonSecondary}"
                    Command="{Binding ExitCalibrationModeCommand}"
                    IsVisible="{Binding IsInCalibrationMode}"
                    SemanticProperties.Description="End Test Mode"
                    AutomationId="ExitCalibrationButton" />
            <Button Text="Skip and Use Defaults"
                    Style="{StaticResource ButtonQuiet}"
                    Command="{Binding SkipCalibrationCommand}"
                    IsVisible="{Binding IsInCalibrationMode}"
                    IsEnabled="{Binding ConnectionInfo.IsConnected}"
                    SemanticProperties.Description="Skip and Use Defaults"
                    AutomationId="SkipCalibrationButton" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
