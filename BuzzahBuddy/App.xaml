<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BuzzahBuddy"
             xmlns:converters="clr-namespace:BuzzahBuddy.Converters"
             xmlns:themes="clr-namespace:BuzzahBuddy.Resources.Styles.Themes"
             x:Class="BuzzahBuddy.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Tokens.g.xaml" />
                <!-- Initial theme; ThemeService swaps this entry at runtime. -->
                <themes:DarkTheme />
                <ResourceDictionary Source="Resources/Styles/Type.g.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:ContinuousModeConverter x:Key="ContinuousModeConverter" />
            <converters:AllTrueConverter x:Key="AllTrueConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
